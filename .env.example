# Portal Postgres (same DB as the backend; migrations owned by backend/prisma).
# NOTE: never the Guacamole DB — Guacamole is only ever read via its REST API.
DATABASE_URL="postgresql://magnetico:magnetico@localhost:5432/portal?schema=public"

# Guacamole webapp base (the /api/* REST endpoints live under this).
GUAC_BASE_URL="http://localhost:8080/guacamole"
# Admin login for the REST API (must have ADMINISTER to list/kill sessions).
GUAC_ADMIN_USER="guacadmin"
GUAC_ADMIN_PASSWORD="guacadmin"
# Data sources to poll, in order; results merge. "postgresql" is the JDBC
# provider; "json" covers token-defined connections if exposed there.
# A source that 404s is skipped with a warning, not a failed tick.
GUAC_DATA_SOURCES="postgresql,json"

# Poll cadence (prompt.md: every 30 seconds).
POLL_INTERVAL_MS="30000"
# Pending sessions with no Guacamole activity older than this are closed out
# (zero charge, full hold refund) so abandoned tickets can't lock holds.
TOKEN_GRACE_MS="120000"
