# Copy to infra/.env — docker compose reads it automatically.

# TODO(google): create an OAuth 2.0 Client ID (type "Web application") in
# Google Cloud Console → APIs & Services → Credentials, with this
# Authorized redirect URI:
#   http://localhost:8180/auth/realms/magnetico/broker/google/endpoint
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Secret of the Keycloak client "magnetico-portal" (confidential OIDC client
# used by the Next.js frontend). Must equal KEYCLOAK_CLIENT_SECRET in
# frontend/.env. Generate: openssl rand -hex 32
PORTAL_CLIENT_SECRET=""

# Google accounts that get the "admin" role (comma-separated). Everyone else
# is a normal "user". Re-applied at every sign-in: remove an email here and
# that person is a normal user again at their next login. Admin roles given
# by hand in the Keycloak console are overwritten by this list.
ADMIN_EMAILS=""

# Where the Next.js frontend runs (redirect + post-logout URIs).
PORTAL_URL="http://localhost:3000"

# Keycloak admin console: http://localhost:8180/auth/admin
KEYCLOAK_ADMIN_USER="admin"
KEYCLOAK_ADMIN_PASSWORD="admin"
KEYCLOAK_DB_PASSWORD="keycloak"

PORTAL_DB_USER="magnetico"
PORTAL_DB_PASSWORD="magnetico"
