# Portal Postgres (this backend + Prisma). NEVER point this at the Guacamole DB.
DATABASE_URL="postgresql://magnetico:magnetico@localhost:5432/portal?schema=public"

# Keycloak realm that brokers Google sign-in (infra/docker-compose.yml).
# Access tokens are verified against this issuer's JWKS; `iss` must match
# exactly, so use the same host the frontend uses to reach Keycloak.
KEYCLOAK_ISSUER="http://localhost:8180/auth/realms/magnetico"
# Tokens must list this client in `aud` (audience mapper in the realm import).
KEYCLOAK_AUDIENCE="magnetico-portal"
# Override for the JWKS document URL when the issuer host is unreachable from
# the backend itself (inside Docker, Keycloak answers as keycloak:8080).
KEYCLOAK_JWKS_URL="http://keycloak:8080/auth/realms/magnetico/protocol/openid-connect/certs"

PORT="4000"
LOG_LEVEL="info"

# Step 5: base URL of Guacamole used to build guacUrl in POST /api/sessions.
# Must match Guacamole's published host port (infra/docker-compose.yml maps
# 8085:8080, so the default below targets :8085 from outside Docker).
GUAC_BASE_URL="http://localhost:8085/guacamole"
# Minutes of rate_per_minute reserved as the session hold when the
# entitlement sets no max_session_min cap.
HOLD_MINUTES_DEFAULT="60"
# Step 7: shared 128-bit key for Guacamole JSON-auth signing, as 32 hex digits.
# MUST equal the guacamole container's JSON_SECRET_KEY (infra/docker-compose.yml).
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# Unset = POST /api/sessions returns the dev stub token instead of a real one.
GUAC_JSON_AUTH_SECRET=""
# Step 7: per-connection Guacamole parameters keyed by guac_connection_id.
# At minimum each entry needs "hostname"; full SSH example:
# GUAC_CONNECTION_PARAMS='{"1": {"hostname": "10.0.0.11", "port": "22", "username": "ops", "password": "…"}}'
# TODO(secrets, step 14): credentials do not belong in env — Vault/KMS next.
GUAC_CONNECTION_PARAMS="{}"
# Step 7b: Guacamole admin login, used to provision per-session JDBC users
# (connection ensure + user create/grant + server-side login). Defaults match
# the compose Guacamole admin.
GUAC_ADMIN_USER="guacadmin"
GUAC_ADMIN_PASSWORD="guacadmin"
# JDBC data source id for the admin REST calls above.
GUAC_DATA_SOURCE="postgresql"
