# Portal Postgres (this backend + Prisma). NEVER point this at the Guacamole DB.
DATABASE_URL="postgresql://magnetico:magnetico@localhost:5432/portal?schema=public"

# Keycloak realm that brokers Google sign-in (infra/docker-compose.yml).
# Access tokens are verified against this issuer's JWKS; `iss` must match
# exactly, so use the same host the frontend uses to reach Keycloak.
KEYCLOAK_ISSUER="http://localhost:8180/auth/realms/magnetico"
# Tokens must list this client in `aud` (audience mapper in the realm import).
KEYCLOAK_AUDIENCE="magnetico-portal"

PORT="4000"
LOG_LEVEL="info"

# Credit is reserved in chunks of this many minutes of a server's rate and
# topped up automatically while the session runs (routes/tunnel.ts).
HOLD_MINUTES_DEFAULT="60"
# Least credit (in seconds of the server's rate) needed to open a session or
# keep it running when a chunk is used up.
MIN_SESSION_CREDIT_SECONDS="60"

# ---- Remote access (Guacamole) ------------------------------------------
# Guacamole as THIS process reaches it. Backend on the host: loopback port
# published by infra/docker-compose.yml. Backend in compose: http://guacamole:8080/guacamole
GUAC_INTERNAL_URL="http://127.0.0.1:8085/guacamole"
# Guacamole service account the backend syncs servers and users with.
# MUST equal GUAC_SERVICE_USER / GUAC_SERVICE_PASSWORD in infra/.env.
# Guacamole dashboard as an admin's browser opens it (links in Admin → Servers).
GUAC_DASHBOARD_URL="http://localhost:8085/guacamole"
GUAC_SERVICE_USER="magnetico-portal"
GUAC_SERVICE_PASSWORD=""
# 256-bit key (64 hex) encrypting server passwords/SSH keys at rest.
# Losing it = admins must re-enter every server credential. Never commit it.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVER_CREDENTIALS_KEY=""
# Display WebSocket as browsers reach it, and the origins allowed to open it.
TUNNEL_PUBLIC_URL="ws://localhost:4000/api/tunnel"
TUNNEL_ALLOWED_ORIGINS="http://localhost:3000"

# Session recordings folder shared with guacd (infra/recordings), as this
# process sees it. Backend on the host: the infra folder next to backend/.
RECORDINGS_DIR="../infra/recordings"
