{
  "name": "magnetico-portal-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Magnetico portal backend — Fastify + Prisma (Portal DB only, Guacamole has its own DB)",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/client": "^6.4.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "fastify-plugin": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "prisma": "^6.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3"
  }
}
